{
  "appId": "com.phmp.pharmacare",
  "appName": "PharmaCare Pro",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#ffffff"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#10b981",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
