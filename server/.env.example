# PHMP — نموذج إعدادات الخادم المحلي
# انسخه إلى .env ثم املأ القيم. لا ترفع .env إلى Git. الصلاحية: chmod 600 .env

NODE_ENV=production
PORT=3001
HOST=127.0.0.1

# سرّ JWT عشوائي قوي (64 حرف hex على الأقل)
JWT_SECRET=ضع-هنا-سراً-عشوائياً-طويلاً

# مفتاح API لحماية /api/sync و/api/data و/api/backup (يبدأ بـ phmp_)
PHMP_API_KEY=phmp_ضع-هنا-مفتاحاً-عشوائياً

# الأصول المسموح لها بالوصول (مفصولة بفواصل)
PHMP_ALLOWED_ORIGINS=https://phmp.pages.dev,https://phmplatform.vercel.app,https://pharmacare-pro-jade.vercel.app,https://phmp-download.pages.dev,http://localhost:5173,capacitor://localhost

# ملف اعتمادات كلمات مرور المستخدمين (600) — بنية: {"users": {...}}
PHMP_SEED_PASSWORDS_FILE=/root/.credentials/phmp.json

# توكن النفق الدائم (من Cloudflare Zero Trust → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=ضع-هنا-توكن-النفق

# مرآة الطلبات مع الطبقة السحابية الدائمة (phmp-realtime) — اتجاهان أفضل جهد:
# سحب الطلبات التي أُنشئت أثناء نوم هذا الخادم + رفع التي وصلت عبر البوابة.
# ضع PHMP_LIVE_SYNC_ENABLED=0 لتعطيلها كلياً.
PHMP_LIVE_SYNC_URL=https://phmp-realtime.balbolghol-ai.workers.dev
# PHMP_LIVE_SYNC_ENABLED=1
